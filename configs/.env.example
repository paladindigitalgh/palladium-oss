# Copy to .env and adjust as needed. All values shown are defaults.

APP_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

LOG_LEVEL=info
LOG_FORMAT=json

# Matches docker-compose.yml's postgres service out of the box.
DB_HOST=localhost
DB_PORT=5432
DB_USER=palladium
DB_PASSWORD=palladium
DB_NAME=palladium
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
