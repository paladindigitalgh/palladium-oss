# Copy to .env and adjust as needed. All values shown are defaults.

APP_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

LOG_LEVEL=info
LOG_FORMAT=json

# Matches docker-compose.yml's postgres service out of the box.
DB_HOST=localhost
DB_PORT=5432
DB_USER=palladium
DB_PASSWORD=palladium
DB_NAME=palladium
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

# WARNING: the default below is for local development only. Every real
# deployment MUST set JWT_SECRET to its own random value — anyone who knows
# this secret can forge a valid login token for any user. Config.Validate
# refuses to start with this exact value when APP_ENV=production.
JWT_SECRET=development-only-change-me-before-deploying
# No refresh tokens exist yet, so this alone controls how often a logged-in
# caller must re-authenticate.
JWT_EXPIRATION=24h

# WARNING: the default below is for local development only, and MUST be
# overridden in every real deployment — anyone who knows it can decrypt
# every Authentication record's Password and PrivateKey ever encrypted
# under it (see internal/authentication, internal/platform/encryption).
# Config.Validate refuses to start with this exact value when
# APP_ENV=production. Generate a real one with:
#   openssl rand -base64 32
PALLADIUM_MASTER_KEY=80azDk64Qom7+ANSVtnDef+mNNinbm98+Da6TsIucH8=
